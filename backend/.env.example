PORT=5000
NODE_ENV=development

# Database configuration:
# For PostgreSQL (Neon Cloud or Local Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_seat_booking?schema=public"
# For SQLite (instant zero-install local dev):
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production-2026-xyz"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"
