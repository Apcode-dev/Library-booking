PORT=5000
NODE_ENV=development

# Database configuration (Neon Cloud PostgreSQL):
# Pooled compute URL for serverless/high concurrency:
DATABASE_URL="postgresql://<user>:<password>@<neon-endpoint>-pooler.c-7.us-east-2.aws.neon.tech/<dbname>?sslmode=require"
# Direct compute URL for DDL/schema migrations:
DIRECT_URL="postgresql://<user>:<password>@<neon-endpoint>.c-7.us-east-2.aws.neon.tech/<dbname>?sslmode=require"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production-2026-xyz"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Brevo (Sendinblue) Transactional Email & OTP Configuration
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="your-sender-email@example.com"
BREVO_SENDER_NAME="LibSpace Platform"

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
